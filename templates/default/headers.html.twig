{% if cur_route in ['maps_map', 'maps_localize_member', 'maps_mymap'] %}
    <link rel="stylesheet" type="text/css" href="{{ url_for("plugin_res", {"plugin": module_id, "path": "maps-main.bundle.min.css"}) }}"/>
    {% if tiles.vector %}
    <link rel="stylesheet" type="text/css" href="{{ url_for("plugin_res", {"plugin": module_id, "path": "maps-gl.bundle.min.css"}) }}"/>
    {% endif %}
    <link rel="stylesheet" type="text/css" href="{{ url_for("plugin_res", {"plugin": module_id, "path": "galette_maps.css"}) }}"/>
{% endif %}
{% if cur_route == 'maps_localize_member' or cur_route == 'maps_mymap' %}
    <link rel="stylesheet" type="text/css" href="{{ url_for("plugin_res", {"plugin": module_id, "path": "maps-locate.bundle.min.css"}) }}"/>
{% endif %}
