{% extends 'page.html.twig' %}

{% block content %}
<section class="map-container">
    <div id="map"></div>
{% if towns is defined and towns|length > 0 %}
    <div id="possible_towns" class="ui tiny modal">
        <div class="header">
        {% if mymap is defined %}
            {{ _T("Choose your location", "maps") }}
        {% else %}
            {{ _T("Choose %member location", "maps")|replace({'%member': member.sname}) }}
        {% endif %}
        </div>
        <div class="content">
            <div class="description">
                <p>{{ _T("Select your town.", "maps") }}<br/>
                {{ _T("In the database, town is set to: '%town'", "maps")|replace({'%town': member.town}) }}</p>
            </div>
        </div>
        <div class="actions">
            <ul>
        {% for t in towns %}
                <li>
                    <button type="button" class="ui labeled button maps-town" data-name="{{ t.full_name }}" data-lat="{{ t.latitude }}" data-lng="{{ t.longitude }}">
                        <span class="ui green button city">{{ t.full_name }}</span>
                        <span class="ui basic label">{{ t.latitude }}/{{ t.longitude }}</span>
                    </button>
                </li>
        {% endfor %}
            </ul>
            <button type="button" class="ui button cancel">{{ _T("Close") }}</button>
        </div>
    </div>
{% endif %}
</section>
{% include '@PluginGaletteMaps/common_html.html.twig' %}
{% endblock %}

{% block javascripts %}
    {% include '@PluginGaletteMaps/common_scripts.html.twig' with {
        page_config: {
            member: {
                name: member.sfullname,
                can_edit: can_edit,
                position: town ?? null,
                store_url: mymap is defined ? url_for("maps_ilivehere") : url_for("maps_ilivehere", {"id": member.id})
            }
        }
    } %}
{% endblock %}
