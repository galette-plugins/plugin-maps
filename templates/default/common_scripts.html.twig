{% if cur_route in ['maps_map', 'maps_localize_member', 'maps_mymap'] %}
    <script type="text/javascript" src="{{ url_for("plugin_res", {"plugin": module_id, "path": "maps-main.bundle.min.js"}) }}"></script>
    {% if tiles.vector %}
    {# a megabyte of MapLibre, only worth loading for a vector background #}
    <script type="text/javascript" src="{{ url_for("plugin_res", {"plugin": module_id, "path": "maps-gl.bundle.min.js"}) }}"></script>
    {% endif %}
{% endif %}
{% if cur_route == 'maps_localize_member' or cur_route == 'maps_mymap' %}
    <script type="text/javascript" src="{{ url_for("plugin_res", {"plugin": module_id, "path": "maps-locate.bundle.min.js"}) }}"></script>
{% endif %}

{% set is_member_page = cur_route == 'maps_localize_member' or cur_route == 'maps_mymap' %}
{% set maps_config = {
    icons: {
        member: url_for("plugin_res", {"plugin": module_id, "path": "images/marker-galette.png"}),
        company: url_for("plugin_res", {"plugin": module_id, "path": "images/marker-galette-pro.png"})
    },
    tiles: tiles,
    center: town is defined ? {lat: town['latitude'], lng: town['longitude'], zoom: 12} : {lat: 46.830133640447386, lng: 2.4609375, zoom: 6},
    locate: is_member_page,
    strings: {
        close: _T("Close"),
        legend: _T("Legend"),
        remove: _T("Remove"),
        fullscreen: _T("Display map in full screen", "maps"),
        fullscreen_exit: _T("Exit full screen", "maps"),
        search_placeholder: (cur_route == 'maps_localize_member' and town is not defined) ? _T("Search your town...", "maps") : _T("Search a town...", "maps"),
        search_error: _T("Sorry, that town could not be found.", "maps"),
        search: _T("Search", "maps"),
        locate: _T("Show me where I am", "maps"),
        locate_outside: _T("You seem located outside the boundaries of the map", "maps"),
        aka: _T("aka", "maps"),
        clicked_at: _T("You clicked at %1$s", "maps"),
        lives_here: mymap is defined ? _T("I live here!", "maps") : _T("Member lives here!", "maps"),
        remove_title: mymap is defined ? _T("Remove my coordinates", "maps") : _T("Remove member coordinates", "maps"),
        remove_confirm: _T("Are you sure you want to remove coordinates from the database?", "maps"),
        store_error: _T("An error occurred during 'I live here' process :(", "maps"),
        remove_error: _T("An error occurred removing coordinates :(", "maps")
    }
}|merge(page_config ?? {}) %}
{# HEX flags keep "</script>" and friends harmless inside the script element #}
<script type="application/json" id="maps-config">{{ maps_config|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
<script type="text/javascript" src="{{ url_for("plugin_res", {"plugin": module_id, "path": "galette_maps.js"}) }}"></script>
