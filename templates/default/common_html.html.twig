{# images are decorative: each one comes with its text #}
<div id="legend">
    <ul class="maps-legend">
        <li>
            <img src="{{ url_for("plugin_res", {"plugin": module_id, "path": "images/marker-galette.png"}) }}" alt=""/>
            {{ _T("Member") }}
        </li>
        <li>
            <img src="{{ url_for("plugin_res", {"plugin": module_id, "path": "images/marker-galette-pro.png"}) }}" alt=""/>
