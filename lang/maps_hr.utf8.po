msgid "Vector tiles"
msgstr "Vektorske pločice"

#: ../templates/default/maps_preferences.html.twig:38
msgid "Tick for a MapLibre style, leave unticked for classic raster tiles."
msgstr ""
"Označite za MapLibre stil; ostavite neoznačeno za klasične rasterske pločice."

#: ../templates/default/maps_preferences.html.twig:46
msgid "Address"
msgstr "Adresa"

#: ../templates/default/maps_preferences.html.twig:46
msgid "Style address for vector tiles, tiles address for raster ones, such as:"
msgstr ""
"Adresa stila za vektorske pločice ili adresa pločica za rasterske, "
"primjerice:"

#: ../templates/default/maps_preferences.html.twig:53
msgid "Attribution"
msgstr "Navođenje izvora"

#: ../templates/default/maps_preferences.html.twig:53
msgid ""
"Credit the provider requires, HTML allowed. Data licences make it mandatory."
msgstr ""
"Tekst navođenja izvora koji pružatelj zahtijeva. HTML je dopušten. Licence "
"podataka obvezuju na navođenje izvora."

#: ../templates/default/maps_preferences.html.twig:60
msgid "Maximum zoom"
msgstr "Najveće povećanje"

#: ../templates/default/maps_preferences.html.twig:68
msgid "Subdomains"
msgstr "Poddomene"

#: ../templates/default/maps_preferences.html.twig:68
msgid ""
"Letters the {s} token in the address is replaced with, such as abc. Raster "
"tiles only."
msgstr ""
"Slova kojima se zamjenjuje oznaka {s} u adresi, primjerice abc. Samo za "
"rasterske pločice."

