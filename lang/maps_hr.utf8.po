msgid "Members positions precision"
msgstr "Preciznost položaja članova"

#: ../templates/default/maps_preferences.html.twig:15
msgid ""
"How far from their stored position members may appear on the map. Staff, "
"administrators and members themselves always see the exact position."
msgstr ""
"Koliko udaljeno od spremljenog položaja član može biti prikazan na karti. "
"Uprava, administratori i sami članovi uvijek vide točan položaj."

#: ../templates/default/maps_preferences.html.twig:26
msgid "Background map provider"
msgstr "Pružatelj kartografske podloge"

